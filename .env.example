# LLM provider: groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq gpt-oss only: low (frozen eval default) | medium | high | none (don't send)
REASONING_EFFORT=low
# Prompt schema: compact (frozen eval default) | full
PROMPT_SCHEMA=compact
