# LLM provider: groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq gpt-oss only: low (frozen eval default) | medium | high | none (don't send)
REASONING_EFFORT=low
# Prompt schema: compact (frozen eval default) | full
PROMPT_SCHEMA=compact
# Multi-agent graph (Groq): per-agent models
PLANNER_MODEL=openai/gpt-oss-120b
DATA_MODEL=openai/gpt-oss-120b
REPORTER_MODEL=openai/gpt-oss-20b
# Critic: a different model family from the agents it reviews, with its own Groq daily quota
CRITIC_MODEL=qwen/qwen3.8-27b
# Daily token budget per model (stop live runs at 90%): local/eval use, and the deployed app
DAILY_TOKEN_BUDGET=200000
APP_DAILY_TOKEN_BUDGET=100000
# Planner question gate (JSON answerable yes|partly|no|meta); on by default, adds ~270 Planner prompt tokens per question
PLANNER_GATE=1
